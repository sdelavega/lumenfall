<!-- Debug builds only: scripts/smoke.sh drives the active bundle through this
     receiver. It must never reach a release build (just smoke-manifest-check).
     DUMP is held by the adb shell but not by ordinary apps, so only `adb shell am
     broadcast` can send the action. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.SmokeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.sdelavega.lumenfall.SMOKE_SET_ACTIVE" />
                <action android:name="com.sdelavega.lumenfall.SMOKE_FORCE_UNIVERSITY_DAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
