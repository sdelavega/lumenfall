<!-- Keeps the long-standing backup behaviour (everything is eligible for cloud
     backup and device-to-device transfer) but states it explicitly, as Android 12+
     requires. The app stores only imported wallpaper bundles and preferences, no
     credentials or tokens. -->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
