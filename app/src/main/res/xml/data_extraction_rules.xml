<!-- Cloud backup keeps shared preferences but skips imported wallpaper bundles
     (files/bundles/, up to 512 MB of third-party content) and the regenerable
     bundled-wallpaper thumbnails (files/bundled-thumbnails/). Device-to-device
     transfer keeps everything. The app stores no credentials or tokens. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="bundles/" />
        <exclude domain="file" path="bundled-thumbnails/" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
