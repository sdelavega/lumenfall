<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/glass_panel_lift_shadow" />
        </shape>
    </item>
    <item android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/glass_field_fill" />
            <stroke android:width="1dp" android:color="@color/glass_field_stroke" />
        </shape>
    </item>
    <item android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/glass_panel_inner_glow" />
        </shape>
    </item>
    <item android:height="4dp" android:gravity="top" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="6dp" android:topRightRadius="6dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_panel_frost"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_dropdown_chevron"
        android:gravity="center_vertical|end"
        android:right="12dp" />
</layer-list>
