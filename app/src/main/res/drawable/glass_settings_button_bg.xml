<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="@color/glass_settings_button_shadow" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/glass_settings_button_top"
                android:endColor="@color/glass_settings_button_bottom" />
            <stroke android:width="1dp" android:color="@color/glass_settings_button_stroke" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/glass_settings_button_glint" />
        </shape>
    </item>
    <item android:height="9dp" android:gravity="top" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_settings_button_glint"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
