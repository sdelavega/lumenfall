<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <!-- Geolocation for web wallpaper bundles that opt in (per-bundle toggle in
         settings). Fine and coarse are both declared (Android 12+ lets the user
         downgrade to approximate); either grant is accepted, and GPS is only
         used when fine is granted. The bridge is only registered for bundles the import
         screener classified "allowed" (not "limited"), so a bundle that trips
         the screener's network/heavy-GPU heuristics never even sees the surface. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The native fetch proxy (NativeFetchBridge) makes HTTP requests on
         behalf of web wallpaper bundles, bypassing the WebView's CORS
         enforcement so bundles can reach external APIs. Without this, the
         proxy can't open any connection. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Lumenfall">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.wallpaper.preview"
                android:resource="@drawable/wallpaper_thumb" />
        </activity>

        <activity
            android:name=".ui.BundleSettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <service
            android:name=".service.LumenfallWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_service_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/lumenfall_wallpaper" />
        </service>
    </application>
</manifest>
